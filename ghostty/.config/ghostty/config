font-family = "JetBrainsMono Nerd Font"
font-size = 14
theme = "Kanagawa Dragon"

# Window styling & frosted glass effect
background-opacity = 0.82
background-blur = 30
unfocused-split-opacity = 0.85
window-padding-x = 12
window-padding-y = 12
window-decoration = true
macos-titlebar-style = transparent

# Clean UI & Kanagawa Dragon Accents
cursor-style = block
cursor-color = #87a987
selection-background = #393836
shell-integration = zsh

# Wichtig für Neovim Keybindings
macos-option-as-alt = false
