{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "separator": "38;2;135;169;135"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;197;201;197",
        "at": "38;2;115;124;115",
        "host": "38;2;135;169;135"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "length": 30,
      "outputColor": "38;2;98;94;90"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "38;2;139;164;176"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "38;2;139;164;176"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "38;2;142;164;162"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "38;2;142;164;162"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "38;2;135;169;135"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "38;2;135;169;135"
    },
    {
      "type": "display",
      "key": "Display",
      "keyColor": "38;2;142;164;162",
      "compactType": "original"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "38;2;142;164;162",
      "format": "AeroSpace"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "38;2;142;164;162"
    },
    {
      "type": "font",
      "key": "Font",
      "keyColor": "38;2;142;164;162",
      "format": "{1}"
    },
    {
      "type": "cursor",
      "key": "Cursor",
      "keyColor": "38;2;142;164;162",
      "format": "{1} ({2}px)"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "38;2;138;154;123"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "38;2;138;154;123",
      "format": "{2} ({5}c)"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "38;2;196;178;138"
    },
    {
      "type": "swap",
      "key": "Swap",
      "keyColor": "38;2;182;146;123"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "38;2;196;116;110",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "battery",
      "key": "Battery",
      "keyColor": "38;2;135;169;135"
    },
    {
      "type": "poweradapter",
      "key": "Power",
      "keyColor": "38;2;135;169;135"
    },
    {
      "type": "sound",
      "key": "Sound",
      "keyColor": "38;2;142;164;162"
    },
    {
      "type": "datetime",
      "key": "Date",
      "keyColor": "38;2;115;124;115",
      "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}"
    },
    {
      "type": "locale",
      "key": "Locale",
      "keyColor": "38;2;115;124;115"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
