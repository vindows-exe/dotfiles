{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file",
    "position": "top",
    "padding": {
      "top": 1,
      "bottom": 1
    }
  },
  "display": {
    "separator": " 󰄾 "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "33"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "33"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "34"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "34"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "35"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "35"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "36"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "36"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "32"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "32"
    },
    "break",
    "colors"
  ]
}
