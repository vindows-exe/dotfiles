{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file",
    "color": {
      "1": "38;2;126;156;216",
      "2": "38;2;106;149;137"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "separator": "38;2;149;127;184"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;220;215;186",
        "at": "38;2;114;113;105",
        "host": "38;2;126;156;216"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "length": 30,
      "outputColor": "38;2;114;113;105"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "38;2;126;156;216"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "38;2;106;149;137"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "38;2;106;149;137"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "38;2;149;127;184"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "38;2;149;127;184"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "38;2;122;168;159"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "38;2;122;168;159"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "38;2;152;187;108"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "38;2;152;187;108"
    },
    "break",
    "colors"
  ]
}
